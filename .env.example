# ====================
# REQUIRED VARIABLES
# ====================

# JWT Secret (IMPORTANT: Generate a secure random string for production)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# MongoDB Connection String (MongoDB Atlas or other cloud MongoDB)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# ====================
# FRONTEND CONFIGURATION
# ====================

# Frontend URL (for CORS configuration in API Gateway)
FRONTEND_URL=http://localhost:5173

# ====================
# SERVICE URLS (for Render deployment)
# ====================

# Auth Service
AUTH_SERVICE_URL=https://apex-dispatch-auth-service.onrender.com

# Order Service
ORDER_SERVICE_URL=https://apex-dispatch-order-service.onrender.com

# Courier Service
COURIER_SERVICE_URL=https://apex-dispatch-courier-service.onrender.com

# Dispatch Service (with /events endpoint)
DISPATCH_SERVICE_URL=https://apex-dispatch-dispatch-service.onrender.com/events

# Tracking Service (with /events endpoint)
TRACKING_SERVICE_URL=https://apex-dispatch-tracking-service.onrender.com/events

# Notification Service (with /events endpoint)
NOTIFICATION_SERVICE_URL=https://apex-dispatch-notification-service.onrender.com/events

# Event Bus URL
# - For API Gateway: Use base URL only (API Gateway appends /events, /dlq, etc.)
#   Example: https://apex-dispatch-event-bus.onrender.com
# - For services that PUBLISH events (Order, Dispatch): Include /events endpoint
#   Example: https://apex-dispatch-event-bus.onrender.com/events
EVENT_BUS_URL=https://apex-dispatch-event-bus.onrender.com

# ====================
# OPTIONAL VARIABLES
# ====================

# Node Environment (development, production)
NODE_ENV=development

# Port (Render assigns this automatically, but you can override for local dev)
# PORT=3000
